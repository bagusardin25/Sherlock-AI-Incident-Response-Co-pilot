# Sherlock Backend Configuration

# IBM Bob API Settings (core reasoning engine — Analyst + Fix agents)
SHERLOCK_BOB_MOCK_MODE=true
SHERLOCK_BOB_API_KEY=your-ibm-bob-api-key-here
SHERLOCK_BOB_API_URL=https://api.ibm-bob.ai/v1/chat/completions
SHERLOCK_BOB_MODEL=bob-v1
SHERLOCK_BOB_TIMEOUT=120
SHERLOCK_BOB_CLI_PATH=bob

# OpenRouter Settings (supporting agents: triage, forensics, postmortem)
SHERLOCK_OPENROUTER_API_KEY=your-openrouter-api-key-here
SHERLOCK_OPENROUTER_MODEL=openai/gpt-4o-mini
SHERLOCK_OPENROUTER_TIMEOUT=60

# Database Settings
SHERLOCK_DATABASE_URL=postgresql+asyncpg://sherlock:sherlock_dev_password@localhost:5432/sherlock_db
SHERLOCK_DATABASE_ECHO=false
SHERLOCK_DATABASE_POOL_SIZE=5
SHERLOCK_DATABASE_MAX_OVERFLOW=10

# Authentication Settings
SHERLOCK_SECRET_KEY=your-secret-key-change-in-production-min-32-chars-long
SHERLOCK_ALGORITHM=HS256
SHERLOCK_ACCESS_TOKEN_EXPIRE_MINUTES=30
SHERLOCK_REFRESH_TOKEN_EXPIRE_DAYS=7

# Google OAuth Settings (Optional - leave empty to disable)
SHERLOCK_GOOGLE_CLIENT_ID=
SHERLOCK_GOOGLE_CLIENT_SECRET=
SHERLOCK_GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback

# Repository Settings
SHERLOCK_FIXTURES_PATH=../fixtures
SHERLOCK_SAMPLE_REPO_PATH=../fixtures/flaky-shop

# Logging
SHERLOCK_LOG_LEVEL=INFO
