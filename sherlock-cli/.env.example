# Sherlock CLI Configuration
# ─────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your values.
# Or use /auth login inside the shell to authenticate interactively.

# Backend API URL
# Local development:
SHERLOCK_API_URL=http://localhost:8000
# Production:
# SHERLOCK_API_URL=https://your-railway-url.up.railway.app

# API Key (get from Dashboard → Settings → API Keys)
SHERLOCK_API_KEY=your-api-key-here

# Dashboard URL (for /open command)
# Local:
SHERLOCK_DASHBOARD_URL=http://localhost:3000
# Production:
# SHERLOCK_DASHBOARD_URL=https://sherlock-xxx.vercel.app

# Mock mode (set true for demos without backend)
SHERLOCK_MOCK=false
