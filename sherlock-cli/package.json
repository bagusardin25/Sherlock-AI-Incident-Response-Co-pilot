    "eventsource": "2.0.2",
    "ora": "8.1.1"
  },
  "devDependencies": {
    "@types/eventsource": "1.1.15",
    "@types/node": "22.10.2",
    "typescript": "5.7.2"
  },
  "type": "module"
}
