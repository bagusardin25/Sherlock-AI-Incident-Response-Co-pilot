{
  "name": "sherlockibm-cli",
  "version": "1.1.0",
  "description": "Sherlock AI Incident Response Co-pilot CLI — from alert to fix PR in seconds",
  "author": "Bagus Ardin",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/bagusardin25/Sherlock-AI-Incident-Response-Co-pilot"
  },
  "keywords": [
    "sherlock",
    "incident-response",
    "ai",
    "ibm-bob",
    "cli",
    "devops",
    "sre"
  ],
  "main": "dist/index.js",
  "bin": {
    "sherlock-cli": "dist/index.js",
    "sherlock": "dist/index.js"
  },
  "files": [
    "dist",
    "scripts/postinstall.js",
    "README.md",
    ".env.example"
  ],
  "scripts": {
